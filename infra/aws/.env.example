# Do not copy an existing local .env blindly. No real secrets belong in Git.
# Run Initialize-Environment.ps1, then fill these deployment-specific values.
API_DOMAIN=api.example.com
TLS_EMAIL=admin@example.com
FRONTEND_ORIGIN=https://barber-chat.netlify.app
# Use a TLS-enabled Supabase connection; sslmode=disable is for local fixtures only.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Keep test while migrating infrastructure. Live needs an isolated live database.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=

# Local builds now; replace by immutable ECR image tags/digests in the AWS stage.
BACKEND_IMAGE=barberchat/backend:aws-local
MIGRATION_IMAGE=barberchat/migrations:aws-local
EVOLUTION_IMAGE=barberchat/evolution:e273b904

DB_TIMEOUT=5s
OPERATION_TIMEOUT=30s
HTTP_TIMEOUT=40s
PUBLIC_BIND_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
PROXY_SUBNET=172.30.80.0/29
CADDY_IPV4_ADDRESS=172.30.80.2
API_IPV4_ADDRESS=172.30.80.3
EVOLUTION_MANAGER_PORT=8081

# Generated as URL-safe random hex by Initialize-Environment.ps1.
RABBITMQ_PASSWORD=
EVOLUTION_DB_PASSWORD=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# Keep off until activation/pairing and test delivery are confirmed.
NOTIFICATION_PLANNING_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_AUTOMATIC_ENABLED=false
# IMPORTANT: copy the EXISTING full keyring when reusing a database with jobs.
# Generating replacement keys alone makes previous encrypted payloads unreadable.
NOTIFICATION_PAYLOAD_ACTIVE_KEY_ID=
NOTIFICATION_PAYLOAD_KEYS=
