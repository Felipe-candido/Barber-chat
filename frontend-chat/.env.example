# HTTP API address, not the PostgreSQL/Supabase connection string.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# Must match DEV_SHOP_SLUG in the backend for local admin creation/listing.
NEXT_PUBLIC_SHOP_SLUG=barbearia-do-felipe

# Public browser configuration from Supabase Dashboard > Project Settings > API.
# Never use sb_secret_*, service_role, DATABASE_URL or a database password here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

