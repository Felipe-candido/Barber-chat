# HTTP API address, not the PostgreSQL/Supabase connection string.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# Shops are selected from GET /api/v1/admin/shops after login; no fixed slug.

# Public browser configuration from Supabase Dashboard > Project Settings > API.
# Never use sb_secret_*, service_role, DATABASE_URL or a database password here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# Landing page (all optional).
# Public site address, used for link previews on WhatsApp and Instagram.
NEXT_PUBLIC_SITE_URL=
# Monthly price shown on the landing page. Empty uses "R$ 49,90/mês".
# Must match the Stripe price in the API's STRIPE_MONTHLY_PRICE_ID.
NEXT_PUBLIC_LANDING_PRICE=
# Free trial days promised on the landing page. Keep 0 until the checkout grants a trial.
NEXT_PUBLIC_TRIAL_DAYS=0
# Sales WhatsApp, digits only with country code (5511999999999). Empty hides the WhatsApp buttons.
NEXT_PUBLIC_SALES_WHATSAPP=
