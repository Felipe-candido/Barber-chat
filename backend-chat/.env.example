# Local development only. Do not reuse these credentials outside localhost.
POSTGRES_USER=barber
POSTGRES_PASSWORD=barber_local_only
POSTGRES_DB=barber
POSTGRES_PORT=55432
RABBITMQ_DEFAULT_USER=barber
RABBITMQ_DEFAULT_PASS=barber_local_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

HTTP_ADDR=127.0.0.1:8080
# Optional local catalog writes. Requires a loopback HTTP_ADDR and an active shop.
# After applying db/seeds/development.sql, set this to barbearia-do-felipe.
DEV_SHOP_SLUG=
# Optional exact local browser origin; no trailing slash. Empty keeps browser access disabled.
DEV_FRONTEND_ORIGIN=
DATABASE_URL=postgres://barber:barber_local_only@127.0.0.1:55432/barber?sslmode=disable
RABBITMQ_URL=amqp://barber:barber_local_only@127.0.0.1:5672/
LOG_LEVEL=INFO
DB_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s
WORKER_INTERVAL=30s
