# Local development only. Do not reuse these credentials outside localhost.
POSTGRES_USER=barber
POSTGRES_PASSWORD=barber_local_only
POSTGRES_DB=barber
POSTGRES_PORT=55432
RABBITMQ_DEFAULT_USER=barber
RABBITMQ_DEFAULT_PASS=barber_local_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

HTTP_ADDR=127.0.0.1:8080
# Deprecated local alias for FRONTEND_ORIGIN.
DEV_FRONTEND_ORIGIN=
# Exact browser origin, e.g. http://127.0.0.1:3000; no trailing slash.
FRONTEND_ORIGIN=
DATABASE_URL=postgres://barber:barber_local_only@127.0.0.1:55432/barber?sslmode=disable
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Optional for self-service registration; same public project key as the frontend.
# Accepts a publishable key or legacy anon key. Never use the service_role key.
SUPABASE_PUBLISHABLE_KEY=
# Optional, server-only legacy service_role JWT for staff invitations.
# Never put this key in frontend .env or any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, server-only. Both empty disables Checkout without breaking login.
# This delivery accepts TEST keys only. Never use NEXT_PUBLIC_ for secrets.
STRIPE_SECRET_KEY=
# Create an active, fixed monthly BRL price in the same Stripe test environment.
STRIPE_MONTHLY_PRICE_ID=
# Optional: signing secret from Stripe CLI / this test webhook destination.
# Configure snapshot events with API version 2026-10-28.endive. Never NEXT_PUBLIC_.
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
RABBITMQ_URL=amqp://barber:barber_local_only@127.0.0.1:5672/
LOG_LEVEL=INFO
DB_TIMEOUT=3s
# Transactional workflows can require several round trips to a remote database.
OPERATION_TIMEOUT=20s
# Includes authentication, authorization and the operation; keep above OPERATION_TIMEOUT.
HTTP_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
WORKER_INTERVAL=30s

# Off by default. Apply migration 00021 before enabling durable planning.
# Planning records jobs only; it does not enable WhatsApp delivery.
NOTIFICATION_PLANNING_ENABLED=false
# Server-only keyring. Example SHAPE: {"key-2026-11":"<32 random bytes in base64>"}
# Keep old keys until their payloads expire; never use NEXT_PUBLIC_ or reuse other secrets.
NOTIFICATION_PAYLOAD_ACTIVE_KEY_ID=
NOTIFICATION_PAYLOAD_KEYS=

# Optional connection integration; all four values are required together.
# Configure this API key to match the separate Evolution installation.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_URL=
EVOLUTION_WEBHOOK_SECRET=
# Optional webhook-only listener for Docker Desktop -> Windows host.
# Local example: 0.0.0.0:8082 with webhook URL
# http://host.docker.internal:8082/api/v1/webhooks/evolution.
# Administrative HTTP_ADDR can stay 127.0.0.1:8080.
EVOLUTION_WEBHOOK_ADDR=
